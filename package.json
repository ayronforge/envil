{
  "name": "@ayronforge/envil",
  "version": "0.7.4",
  "description": "Type-safe environment variable validation using Effect Schema",
  "keywords": [
    "effect",
    "env",
    "environment",
    "schema",
    "type-safe",
    "typescript",
    "validation"
  ],
  "homepage": "https://github.com/ayronforge/envil#readme",
  "bugs": {
    "url": "https://github.com/ayronforge/envil/issues"
  },
  "license": "MIT",
  "author": "Pedro Toledo",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayronforge/envil.git"
  },
  "bin": {
    "envil": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js"
    },
    "./aws": {
      "types": "./dist/resolvers/aws.d.ts",
      "import": "./dist/resolvers/aws.js"
    },
    "./azure": {
      "types": "./dist/resolvers/azure.d.ts",
      "import": "./dist/resolvers/azure.js"
    },
    "./gcp": {
      "types": "./dist/resolvers/gcp.d.ts",
      "import": "./dist/resolvers/gcp.js"
    },
    "./1password": {
      "types": "./dist/resolvers/onepassword.d.ts",
      "import": "./dist/resolvers/onepassword.js"
    },
    "./plugins/vite": {
      "types": "./dist/plugins/vite.d.ts",
      "import": "./dist/plugins/vite.js"
    },
    "./plugins/rollup": {
      "types": "./dist/plugins/rollup.d.ts",
      "import": "./dist/plugins/rollup.js"
    },
    "./plugins/rolldown": {
      "types": "./dist/plugins/rolldown.d.ts",
      "import": "./dist/plugins/rolldown.js"
    },
    "./plugins/webpack": {
      "types": "./dist/plugins/webpack.d.ts",
      "import": "./dist/plugins/webpack.js"
    },
    "./plugins/rspack": {
      "types": "./dist/plugins/rspack.d.ts",
      "import": "./dist/plugins/rspack.js"
    },
    "./plugins/esbuild": {
      "types": "./dist/plugins/esbuild.d.ts",
      "import": "./dist/plugins/esbuild.js"
    }
  },
  "scripts": {
    "build": "tsdown && bun run scripts/verify-package.ts",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware ./src",
    "lint:fix": "oxlint --type-aware --fix ./src",
    "fmt": "oxfmt ./src ./docs",
    "fmt:check": "oxfmt --check ./src",
    "check": "bun run lint:fix && bun run fmt",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "typescript6": "npm:typescript@6.0.3",
    "unplugin": "2.3.11"
  },
  "devDependencies": {
    "@1password/sdk": "0.3.1",
    "@aws-sdk/client-secrets-manager": "3.984.0",
    "@azure/identity": "4.13.0",
    "@azure/keyvault-secrets": "4.10.0",
    "@google-cloud/secret-manager": "6.1.1",
    "@rspack/core": "^2.1.7",
    "@types/bun": "^1.3.8",
    "@types/node": "^25.2.1",
    "effect": "4.0.0-beta.102",
    "esbuild": "^0.28.1",
    "esbuild-loader": "^4.5.0",
    "oxfmt": "^0.24.0",
    "oxlint": "^1.39.0",
    "oxlint-tsgolint": "^0.11.0",
    "rolldown": "^1.2.1",
    "rollup": "^4.62.3",
    "tsdown": "^0.22.14",
    "typescript": "7.0.2",
    "vite": "6.4.1",
    "webpack": "^5.109.2"
  },
  "peerDependencies": {
    "@1password/sdk": "^0.3.1",
    "@aws-sdk/client-secrets-manager": "^3.984.0",
    "@azure/identity": "^4.13.0",
    "@azure/keyvault-secrets": "^4.10.0",
    "@google-cloud/secret-manager": "^6.1.1",
    "effect": "4.0.0-beta.102"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-secrets-manager": {
      "optional": true
    },
    "@azure/keyvault-secrets": {
      "optional": true
    },
    "@azure/identity": {
      "optional": true
    },
    "@google-cloud/secret-manager": {
      "optional": true
    },
    "@1password/sdk": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
